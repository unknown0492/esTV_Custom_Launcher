<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full screen, no action bar (a TV launcher) -->
    <style name="Theme.CustomLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/home_button_focused</item>
    </style>

    <!-- One Secret Menu label (grey box) -->
    <style name="SecretLabel">
        <item name="android:layout_width">@dimen/secret_label_width</item>
        <item name="android:layout_height">@dimen/secret_row_height</item>
        <item name="android:layout_marginEnd">@dimen/secret_row_margin</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@color/secret_label</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/secret_text</item>
    </style>

    <!-- One Secret Menu value (text) -->
    <style name="SecretValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/secret_row_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/secret_value</item>
        <item name="android:textSize">@dimen/secret_text</item>
    </style>

    <!-- One Secret Menu button -->
    <style name="SecretButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/secret_row_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/secret_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/secret_text</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- One Secret Menu row: label + value side by side -->
    <!-- A Secret Menu value that may be long (property name): smaller text, up to 3 lines in the same row height -->
    <style name="SecretValueMultiLine" parent="SecretValue">
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">3</item>
        <item name="android:textSize">@dimen/secret_text_small</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">0.9</item>
    </style>

    <style name="SecretRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/secret_row_margin</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>

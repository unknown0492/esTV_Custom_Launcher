<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen button: dark glass, white frame and lighter fill when focused with the remote -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_button_focused" />
            <stroke android:width="4dp" android:color="@color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_button_focused" />
            <stroke android:width="4dp" android:color="@color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/home_button_normal" />
            <stroke android:width="2dp" android:color="@color/home_button_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Secret Menu button, as in esTVLauncher (focus image), with a visible resting state -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/secret_button_focus" android:state_focused="true" />
    <item android:drawable="@drawable/secret_button_focus" android:state_pressed="true" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/secret_button" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: full-screen wallpaper, buttons centred (rows are added in HomeActivity) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/iv_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_default" />

    <LinearLayout
        android:id="@+id/ll_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical" />

    <!-- Auto-start countdown ("Starting <app> in N s - press any key to cancel"), shown by HomeActivity -->
    <TextView
        android:id="@+id/tv_autostart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/autostart_margin_bottom"
        android:background="@drawable/autostart_pill"
        android:gravity="center"
        android:paddingStart="@dimen/autostart_padding_h"
        android:paddingTop="@dimen/autostart_padding_v"
        android:paddingEnd="@dimen/autostart_padding_h"
        android:paddingBottom="@dimen/autostart_padding_v"
        android:textColor="@color/white"
        android:textSize="@dimen/autostart_text"
        android:visibility="gone" />

</FrameLayout>
